{
  "name": "@awaken/ui",
  "version": "0.15.2",
  "description": "Shared, product-neutral React UI primitives for Awaken products.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "build/console-artifact.mjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./build/console-artifact": "./build/console-artifact.mjs",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/contract.css": "./dist/styles/contract.css",
    "./styles/components.css": "./dist/styles/components.css",
    "./styles/themes/awaken.css": "./dist/styles/themes/awaken.css",
    "./styles/themes/oversight.css": "./dist/styles/themes/oversight.css",
    "./styles.css": "./dist/styles.css",
    "./brand": {
      "types": "./dist/brand/marks.d.ts",
      "import": "./dist/brand/marks.js"
    },
    "./brand/react": {
      "types": "./dist/brand/react.d.ts",
      "import": "./dist/brand/react.js"
    },
    "./brand/styles.css": "./dist/styles/brand.css",
    "./brand/vite": {
      "types": "./dist/brand/vite.d.ts",
      "import": "./dist/brand/vite.js"
    },
    "./brand/appearance": {
      "types": "./dist/brand/appearance.d.ts",
      "import": "./dist/brand/appearance.js"
    },
    "./brand/family.css": "./dist/styles/family.css",
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./icons/data": {
      "types": "./dist/icons/data.d.ts",
      "import": "./dist/icons/data.js"
    },
    "./i18n": {
      "types": "./dist/i18n/core.d.ts",
      "import": "./dist/i18n/core.js"
    },
    "./i18n/react": {
      "types": "./dist/i18n/react.d.ts",
      "import": "./dist/i18n/react.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:artifact && pnpm boundaries:check && pnpm build",
    "test:artifact": "cargo test --locked --manifest-path crates/awaken-ui-artifact/Cargo.toml",
    "clean": "node scripts/clean.mjs",
    "dev": "vite --config vite.dev.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:watch": "vitest",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "dompurify": "3.3.0",
    "lucide": "0.468.0",
    "marked": "18.0.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "27.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.6.0"
}
